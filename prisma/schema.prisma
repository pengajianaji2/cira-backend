generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String
  passwordHash   String
  roles          String[]         @default(["developer"])
  whatsapp       String?
  instagram      String?
  isActive       Boolean          @default(true)
  isPrimaryOwner Boolean          @default(false)
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  projects        Project[]        @relation("UserProjects")
  tasks           Task[]           @relation("AssignedTasks")
  payments        Payment[]        @relation("VerifiedPayments")
  activities      ActivityLog[]
  sentInvitations UserInvitation[] @relation("InvitedUsers")

  @@map("users")
}

model UserInvitation {
  id          String   @id @default(uuid())
  email       String
  role        String   // developer, operasional
  token       String   @unique
  expiresAt   DateTime
  invitedById String
  invitedBy   User     @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("user_invitations")
}

model Project {
  id            String        @id @default(uuid())
  name          String
  clientName    String
  clientContact String
  status        String        @default("lead") // lead, active, completed, cancelled
  contractValue Float         @default(0)
  prdContent    String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ownerId       String?
  owner         User?         @relation("UserProjects", fields: [ownerId], references: [id])
  tasks         Task[]
  payments      Payment[]
  assets        DesignAsset[]
  activities    ActivityLog[]

  @@map("projects")
  @@index([createdAt])
  @@index([status, createdAt])
}

model Task {
  id           String   @id @default(uuid())
  projectId    String
  title        String
  description  String?  @db.Text
  status       String   @default("todo") // todo, in_progress, done
  priority     String   @default("medium") // low, medium, high, urgent
  order        Int      @default(0)
  assigneeName String?
  assigneeRole String?
  assigneeId   String?
  assignee     User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
  @@index([projectId, status, order])
}

model Payment {
  id              String    @id @default(uuid())
  projectId       String
  title           String
  amount          Float
  status          String    @default("pending") // pending, verified
  dueDate         String?
  notes           String?   @db.Text
  proofUrl        String?   @db.Text
  proofFileName   String?
  proofUploadedAt DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedByName  String?
  verifiedBy      User?     @relation("VerifiedPayments", fields: [verifiedById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model DesignAsset {
  id               String   @id @default(uuid())
  projectId        String
  name             String
  originalSize     Int
  compressedSize   Int
  compressionRatio Int
  dataUrl          String   @db.Text
  mimeType         String
  createdAt        DateTime @default(now())

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("design_assets")
  @@index([projectId, createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  projectId   String
  category    String   // project, task, finance, asset, auth
  action      String
  description String   @db.Text
  userName    String?
  userRole    String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  metadata    Json?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
  @@index([projectId, createdAt])
  @@index([projectId, category, createdAt])
}
