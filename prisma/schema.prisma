generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String
  passwordHash   String
  roles          String[]         @default(["developer"])
  whatsapp       String?
  instagram      String?
  isActive       Boolean          @default(true)
  isPrimaryOwner Boolean          @default(false)
  avatarUrl      String?
  tokenVersion   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  projects                 Project[]              @relation("UserProjects")
  tasks                    Task[]                 @relation("AssignedTasks")
  payments                 Payment[]              @relation("VerifiedPayments")
  activities               ActivityLog[]
  sentInvitations          UserInvitation[]       @relation("InvitedUsers")
  projectRosters           ProjectRoster[]
  requestedStatusChanges   ProjectStatusRequest[] @relation("RequestedStatusChanges")
  decidedStatusChanges     ProjectStatusRequest[] @relation("FinalDecidedStatusChanges")
  statusVotes              ProjectStatusVote[]
  prdVersions              PrdVersion[]
  passwordResetTokens      PasswordResetToken[]

  @@map("users")
}

model UserInvitation {
  id          String   @id @default(uuid())
  email       String
  role        String   // developer, operasional
  token       String   @unique
  expiresAt   DateTime
  invitedById String
  invitedBy   User     @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("user_invitations")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RolePolicy {
  role        String   @id
  permissions String[] @default([])
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("role_policies")
}

model AuthRateLimit {
  keyHash   String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@map("auth_rate_limits")
}

model RolePolicyHistory {
  id                 String   @id @default(uuid())
  role               String
  addedPermissions   String[] @default([])
  removedPermissions String[] @default([])
  actorId            String
  actorEmail         String
  createdAt          DateTime @default(now())

  @@index([role, createdAt])
  @@map("role_policy_history")
}

model Project {
  id            String        @id @default(uuid())
  name          String
  clientName    String
  clientContact String
  status        String        @default("lead") // lead, active, completed, cancelled
  repoType      String        @default("monorepo") // monorepo, separate
  progress      Float         @default(0)
  contractValue Decimal       @default(0) @db.Decimal(20, 2)
  prdContent    String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ownerId         String?
  owner           User?                   @relation("UserProjects", fields: [ownerId], references: [id])
  tasks           Task[]
  sprints         Sprint[]
  payments        Payment[]
  paymentTerms    PaymentTerm[]
  assets          DesignAsset[]
  activities      ActivityLog[]
  roster          ProjectRoster[]
  statusRequests  ProjectStatusRequest[]
  repositoryLinks ProjectRepositoryLink[]
  prdVersions     PrdVersion[]

  @@map("projects")
  @@index([createdAt])
  @@index([status, createdAt])
}

model ProjectRoster {
  id            String   @id @default(uuid())
  projectId     String
  userId        String
  roleInProject String?  // e.g. lead, developer, operasional, member
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_rosters")
  @@index([projectId])
  @@index([userId])
}

model ProjectStatusRequest {
  id                String              @id @default(uuid())
  projectId         String
  targetStatus      String              // lead, active, completed, cancelled
  reason            String              @db.Text
  status            String              @default("pending") // pending, approved, rejected
  requestedById     String
  requestedBy       User                @relation("RequestedStatusChanges", fields: [requestedById], references: [id])
  finalDecisionById String?
  finalDecisionBy   User?               @relation("FinalDecidedStatusChanges", fields: [finalDecisionById], references: [id])
  finalDecision     String?             // approved, rejected
  finalReason       String?             @db.Text
  finalDecisionAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  votes             ProjectStatusVote[]

  @@map("project_status_requests")
  @@index([projectId, status])
  @@index([createdAt])
}

model ProjectStatusVote {
  id        String               @id @default(uuid())
  requestId String
  userId    String
  vote      String               // approve, reject
  reason    String?              @db.Text
  createdAt DateTime             @default(now())

  request   ProjectStatusRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@map("project_status_votes")
  @@index([requestId])
  @@index([userId])
}

model ProjectRepositoryLink {
  id        String   @id @default(uuid())
  projectId String
  label     String   // e.g. "Frontend", "Backend", "Mobile", "Repository Utama"
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_repository_links")
  @@index([projectId])
}

model PrdVersion {
  id                String   @id @default(uuid())
  projectId         String
  versionNumber     Int
  compressedContent Bytes
  charCount         Int
  description       String?
  createdById       String?
  createdBy         User?    @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@map("prd_versions")
  @@index([projectId, versionNumber])
  @@index([createdAt])
}

model Sprint {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  goal        String?   @db.Text
  status      String    @default("planning") // planning, active, completed
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  paymentTerms PaymentTerm[]

  @@map("sprints")
  @@index([projectId, status])
  @@index([createdAt])
}

model Task {
  id           String   @id @default(uuid())
  projectId    String
  sprintId     String?
  title        String
  description  String?  @db.Text
  status       String   @default("todo") // todo, in_progress, done
  priority     String   @default("medium") // low, medium, high, urgent
  storyPoints  Int?
  order        Int      @default(0)
  assigneeName String?
  assigneeRole String?
  assigneeId   String?
  assignee     User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@map("tasks")
  @@index([projectId, status, order])
  @@index([sprintId])
}

model Payment {
  id              String    @id @default(uuid())
  projectId       String
  title           String
  amount          Decimal   @db.Decimal(20, 2)
  status          String    @default("pending") // pending, verified
  dueDate         String?
  notes           String?   @db.Text
  proofUrl        String?   @db.Text
  proofFileName   String?
  proofUploadedAt DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedByName  String?
  verifiedBy      User?     @relation("VerifiedPayments", fields: [verifiedById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model PaymentTerm {
  id                       String    @id @default(uuid())
  projectId                String
  termNumber               Int
  title                    String
  percentage               Float
  amount                   Decimal   @db.Decimal(20, 2)
  triggerType              String    @default("manual") // date, sprint, manual
  triggerDate              String?   // YYYY-MM-DD (Asia/Jakarta date-only)
  requiredCompletedSprints Int?
  triggerSprintId          String?   // Legacy field dipertahankan sampai audit consumer selesai
  dueDate                  String?   // Legacy field dipertahankan sampai audit consumer selesai
  status                   String    @default("planned") // planned, ready, invoiced, paid
  readyAt                  DateTime?
  bastUrl                  String?   @db.Text
  bastFileName             String?
  bastUploadedAt           DateTime?
  invoiceNumber            String?   @unique
  invoiceIssuedAt          DateTime?
  invoiceDueDate           String?   // YYYY-MM-DD (Asia/Jakarta date-only)
  paidAt                   DateTime?
  invoicePdfUrl            String?   @db.Text
  isLocked                 Boolean   @default(false)
  notes                    String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  project                  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggerSprint            Sprint?   @relation(fields: [triggerSprintId], references: [id], onDelete: SetNull)

  @@map("payment_terms")
  @@index([projectId, termNumber])
  @@index([projectId, status])
  @@index([status, triggerType, triggerDate])
  @@index([status, invoiceDueDate])
  @@index([status, readyAt])
  @@index([invoiceNumber])
}

model DesignAsset {
  id               String   @id @default(uuid())
  projectId        String
  name             String
  originalSize     Int
  compressedSize   Int
  compressionRatio Int
  dataUrl          String   @db.Text
  mimeType         String
  createdAt        DateTime @default(now())

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("design_assets")
  @@index([projectId, createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  projectId   String
  category    String   // project, task, finance, asset, auth
  action      String
  description String   @db.Text
  userName    String?
  userRole    String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  metadata    Json?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
  @@index([projectId, createdAt])
  @@index([projectId, category, createdAt])
}
