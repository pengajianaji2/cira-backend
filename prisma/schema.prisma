generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String
  passwordHash   String
  roles          String[]         @default(["developer"])
  whatsapp       String?
  instagram      String?
  isActive       Boolean          @default(true)
  isPrimaryOwner Boolean          @default(false)
  avatarFileId   String? @unique
  avatar         StoredFile? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  uploadedFiles  StoredFile[] @relation("FileUploader")
  ownedFiles     StoredFile[] @relation("FileOwner")
  uploadSessions FileUploadSession[]
  tokenVersion   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  projects                 Project[]              @relation("UserProjects")
  tasks                    Task[]                 @relation("AssignedTasks")
  payments                 Payment[]              @relation("VerifiedPayments")
  activities               ActivityLog[]
  sentInvitations          UserInvitation[]       @relation("InvitedUsers")
  projectRosters           ProjectRoster[]
  requestedStatusChanges   ProjectStatusRequest[] @relation("RequestedStatusChanges")
  decidedStatusChanges     ProjectStatusRequest[] @relation("FinalDecidedStatusChanges")
  statusVotes              ProjectStatusVote[]
  prdVersions              ProjectPrdVersion[]
  passwordResetTokens      PasswordResetToken[]
  createdOperationalEvents OperationalEvent[]     @relation("CreatedOperationalEvents")
  updatedOperationalEvents OperationalEvent[]     @relation("UpdatedOperationalEvents")

  @@map("users")
}

model UserInvitation {
  id          String   @id @default(uuid())
  email       String
  role        String   // developer, operasional
  token       String   @unique
  expiresAt   DateTime
  invitedById String
  invitedBy   User     @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("user_invitations")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RolePolicy {
  role        String   @id
  permissions String[] @default([])
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("role_policies")
}

model AuthRateLimit {
  keyHash   String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@map("auth_rate_limits")
}

model RolePolicyHistory {
  id                 String   @id @default(uuid())
  role               String
  addedPermissions   String[] @default([])
  removedPermissions String[] @default([])
  actorId            String
  actorEmail         String
  createdAt          DateTime @default(now())

  @@index([role, createdAt])
  @@map("role_policy_history")
}

model Project {
  id            String        @id @default(uuid())
  name          String
  clientName    String
  clientContact String
  status        String        @default("lead") // lead, active, completed, cancelled
  repoType      String        @default("monorepo") // monorepo, separate
  progress      Float         @default(0)
  contractValue Decimal       @default(0) @db.Decimal(20, 2)
  driveFolderId String?
  deletionState String?
  storedFiles StoredFile[]
  uploadSessions FileUploadSession[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ownerId           String?
  owner             User?                   @relation("UserProjects", fields: [ownerId], references: [id])
  tasks             Task[]
  sprints           Sprint[]
  payments          Payment[]
  paymentTerms      PaymentTerm[]
  assets            DesignAsset[]
  activities        ActivityLog[]
  roster            ProjectRoster[]
  statusRequests    ProjectStatusRequest[]
  repositoryLinks   ProjectRepositoryLink[]
  prdVersions       ProjectPrdVersion[]
  operationalEvents OperationalEvent[]

  @@map("projects")
  @@index([createdAt])
  @@index([status, createdAt])
}

model ProjectRoster {
  id            String   @id @default(uuid())
  projectId     String
  userId        String
  roleInProject String?  // e.g. lead, developer, operasional, member
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_rosters")
  @@index([projectId])
  @@index([userId])
}

model ProjectStatusRequest {
  id                String              @id @default(uuid())
  projectId         String
  targetStatus      String              // lead, active, completed, cancelled
  reason            String              @db.Text
  status            String              @default("pending") // pending, approved, rejected
  requestedById     String
  requestedBy       User                @relation("RequestedStatusChanges", fields: [requestedById], references: [id])
  finalDecisionById String?
  finalDecisionBy   User?               @relation("FinalDecidedStatusChanges", fields: [finalDecisionById], references: [id])
  finalDecision     String?             // approved, rejected
  finalReason       String?             @db.Text
  finalDecisionAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  votes             ProjectStatusVote[]

  @@map("project_status_requests")
  @@index([projectId, status])
  @@index([createdAt])
}

model ProjectStatusVote {
  id        String               @id @default(uuid())
  requestId String
  userId    String
  vote      String               // approve, reject
  reason    String?              @db.Text
  createdAt DateTime             @default(now())

  request   ProjectStatusRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@map("project_status_votes")
  @@index([requestId])
  @@index([userId])
}

model ProjectRepositoryLink {
  id        String   @id @default(uuid())
  projectId String
  label     String   // e.g. "Frontend", "Backend", "Mobile", "Repository Utama"
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_repository_links")
  @@index([projectId])
}

model ProjectPrdVersion {
  id String @id @default(uuid())
  projectId String
  versionNumber Int
  fileId String @unique
  description String?
  createdById String?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy User? @relation(fields: [createdById], references: [id])
  @@unique([projectId, versionNumber])
  @@map("project_prd_versions")
}

model Sprint {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  goal        String?   @db.Text
  status      String    @default("planning") // planning, active, completed
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  paymentTerms PaymentTerm[]

  @@map("sprints")
  @@index([projectId, status])
  @@index([createdAt])
}

model Task {
  id           String   @id @default(uuid())
  projectId    String
  sprintId     String?
  title        String
  description  String?  @db.Text
  status       String   @default("todo") // todo, in_progress, done
  priority     String   @default("medium") // low, medium, high, urgent
  storyPoints  Int?
  order        Int      @default(0)
  assigneeName String?
  assigneeRole String?
  assigneeId   String?
  assignee     User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@map("tasks")
  @@index([projectId, status, order])
  @@index([sprintId])
}

model Payment {
  id              String    @id @default(uuid())
  projectId       String
  title           String
  amount          Decimal   @db.Decimal(20, 2)
  status          String    @default("pending") // pending, verified
  dueDate         String?
  notes           String?   @db.Text
  proofFileId     String? @unique
  proof StoredFile? @relation("PaymentProof", fields: [proofFileId], references: [id], onDelete: SetNull)
  uploadSessions FileUploadSession[]
  proofFileName   String?
  proofUploadedAt DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedByName  String?
  verifiedBy      User?     @relation("VerifiedPayments", fields: [verifiedById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model PaymentTerm {
  id                       String    @id @default(uuid())
  projectId                String
  termNumber               Int
  title                    String
  percentage               Float
  amount                   Decimal   @db.Decimal(20, 2)
  triggerType              String    @default("manual") // date, sprint, manual
  triggerDate              String?   // YYYY-MM-DD (Asia/Jakarta date-only)
  requiredCompletedSprints Int?
  triggerSprintId          String?   // Legacy field dipertahankan sampai audit consumer selesai
  dueDate                  String?   // Legacy field dipertahankan sampai audit consumer selesai
  status                   String    @default("planned") // planned, ready, invoiced, paid
  readyAt                  DateTime?
  bastFileId               String? @unique
  bast StoredFile? @relation("TermBast", fields: [bastFileId], references: [id], onDelete: SetNull)
  uploadSessions FileUploadSession[]
  bastFileName             String?
  bastUploadedAt           DateTime?
  invoiceNumber            String?   @unique
  invoiceIssuedAt          DateTime?
  invoiceDueDate           String?   // YYYY-MM-DD (Asia/Jakarta date-only)
  paidAt                   DateTime?
  invoiceFileId            String? @unique
  invoiceFile StoredFile? @relation("TermInvoice", fields: [invoiceFileId], references: [id], onDelete: SetNull)
  isLocked                 Boolean   @default(false)
  notes                    String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  project                  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggerSprint            Sprint?   @relation(fields: [triggerSprintId], references: [id], onDelete: SetNull)

  @@map("payment_terms")
  @@index([projectId, termNumber])
  @@index([projectId, status])
  @@index([status, triggerType, triggerDate])
  @@index([status, invoiceDueDate])
  @@index([status, readyAt])
  @@index([invoiceNumber])
}

model DesignAsset {
  id               String   @id @default(uuid())
  projectId        String
  name             String
  originalSize     Int
  compressedSize   Int
  compressionRatio Int
  fileId String @unique
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  mimeType         String
  createdAt        DateTime @default(now())

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("design_assets")
  @@index([projectId, createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  projectId   String
  category    String   // project, task, finance, asset, auth
  action      String
  description String   @db.Text
  userName    String?
  userRole    String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  metadata    Json?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@map("activity_logs")
  @@index([projectId, createdAt])
  @@index([projectId, category, createdAt])
}

model OperationalEvent {
  id               String    @id @default(uuid())
  title            String
  eventType        String    // client_demo, deployment, maintenance, meeting
  description      String?   @db.Text
  startAt          DateTime
  endAt            DateTime?
  allDay           Boolean   @default(false)
  allDayStartDate  String?   // YYYY-MM-DD (Asia/Jakarta date-only)
  allDayEndDate    String?   // YYYY-MM-DD (Asia/Jakarta date-only)
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status           String    @default("scheduled") // scheduled, cancelled
  createdById      String?
  createdBy        User?     @relation("CreatedOperationalEvents", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?     @relation("UpdatedOperationalEvents", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?   @db.Text
  lastRemindedAt   DateTime?
  lastRemindedById String?
  reminderNote     String?   @db.Text
  reminderCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("operational_events")
  @@index([status, startAt])
  @@index([status, allDay, allDayStartDate])
  @@index([projectId, status])
}

enum FileCategory {
  AVATAR
  DESIGN
  PROOF
  BAST
  PRD
  INVOICE
}

model StoredFile {
  id String @id @default(uuid())
  provider String @default("GOOGLE_DRIVE")
  driveFileId String @unique
  originalName String
  storageName String
  mimeType String
  sizeBytes Int
  checksum String?
  category FileCategory
  status String @default("ACTIVE")
  projectId String?
  ownerUserId String?
  uploaderId String
  createdAt DateTime @default(now())
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner User? @relation("FileOwner", fields: [ownerUserId], references: [id])
  uploader User @relation("FileUploader", fields: [uploaderId], references: [id])
  avatarFor User? @relation("UserAvatar")
  asset DesignAsset?
  proofFor Payment? @relation("PaymentProof")
  bastFor PaymentTerm? @relation("TermBast")
  invoiceFor PaymentTerm? @relation("TermInvoice")
  prdVersion ProjectPrdVersion?
  @@index([projectId, status])
  @@map("stored_files")
}

model FileUploadSession {
  id String @id @default(uuid())
  userId String
  projectId String?
  paymentId String?
  termId String?
  category FileCategory
  originalName String
  storageName String
  mimeType String
  sizeBytes Int
  driveFileId String @unique
  folderId String
  encryptedUri String?
  offset Int @default(0)
  signatureVerified Boolean @default(false)
  status String @default("INITIALIZING")
  resultFileId String?
  description String?
  originalSize Int?
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  term PaymentTerm? @relation(fields: [termId], references: [id], onDelete: Cascade)
  @@index([status, expiresAt])
  @@map("file_upload_sessions")
}

model ProjectDeletionJob {
  id String @id @default(uuid())
  projectSnapshotId String @unique
  projectName String
  actorId String
  state String @default("REQUESTED")
  failureCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  items ProjectDeletionItem[]
  @@map("project_deletion_jobs")
}

model ProjectDeletionItem {
  id String @id @default(uuid())
  jobId String
  driveFileId String
  kind String @default("FILE")
  done Boolean @default(false)
  job ProjectDeletionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, driveFileId])
  @@map("project_deletion_items")
}

model ProjectDeletionAudit {
  id String @id @default(uuid())
  projectSnapshotId String
  projectName String
  actorId String
  result String
  createdAt DateTime @default(now())
  @@map("project_deletion_audits")
}
