# Backend service
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cira_pm
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/cira_pm
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Optional email delivery (both values required together)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Private Google Drive storage (backend only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
FILE_SESSION_ENCRYPTION_KEY=
FILE_UPLOAD_MAX_AVATAR_BYTES=5242880
FILE_UPLOAD_MAX_DESIGN_BYTES=2097152
FILE_UPLOAD_MAX_DOCUMENT_BYTES=26214400
FILE_UPLOAD_CHUNK_BYTES=4194304
